+    def test_unknown_commit_hashes_enter_repair_on_reduced_provider_schema(self):
+        manifest_path = self.packet / 'manifest.json'
+        manifest = json.loads(manifest_path.read_text())
+        manifest['editorial_schema_version'] = 3
+        manifest_path.write_text(json.dumps(manifest))
+        valid = dict(fixture(), schema_version=3, findings=[])
+        finding = {
+            'id': 'fixture-boundary', 'origin': 'authoring_observation',
+            'status': 'suspected', 'classification': 'defect', 'description': 'Boundary',
+            'trigger': 'Zero input', 'expected_behavior': 'Returns zero',
+            'actual_behavior': 'Raises',
+            'locations': [{'commit': 'c' * 40, 'path': 'fixture.py', 'symbol': 'fixture'}],
+            'source_evidence': ['read-1'],
+            'verification': [{'method': 'source_inspection', 'description': 'Read fixture',
+                              'evidence': ['read-1'], 'limits': 'Source only'}],
+        }
+        for field, refused, reason in (
+            ('links', dict(valid, links=['c' * 40]), 'annotation.links[]: unknown value'),
+            ('locations', dict(valid, findings=[finding]),
+             'annotation.findings[].locations[].commit: unknown value'),
+        ):
+            with self.subTest(field=field):
+                transport = RepairTransport(first=json.dumps(refused), second=json.dumps(valid))
+                result = self.run_teacher(transport)
+                starts = [params for method, params in transport.requests if method == 'turn/start']
+                self.assertEqual(len(starts), 2)
+                for params in starts:
+                    schema = params['outputSchema']
+                    self.assertEqual(schema, provider_output_schema(manifest))
