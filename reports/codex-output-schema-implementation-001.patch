+    def test_provider_schema_changes_only_commit_enums(self):
+        task, ancestor = 'a' * 40, 'b' * 40
+        for version in (2, 3, 4, 5):
+            for entries in ([], [{'sha': ancestor}]):
+                with self.subTest(version=version, links=bool(entries)):
+                    manifest = {
+                        'task_sha': task, 'commits': [ancestor],
+                        'ancestor_entries': entries, 'editorial_schema_version': version,
+                        'authoring_task': {
+                            'kind': 'chapter', 'id': 'one',
+                            'chapter_catalog': [{'id': 'one'}, {'id': 'two'}],
+                        },
+                    }
+                    full = output_schema(manifest)
+                    expected = deepcopy(full)
+                    links = expected['properties']['links']
+                    if entries:
+                        self.assertEqual(links['items'].pop('enum'), [ancestor])
+                    else:
+                        self.assertEqual(links['maxItems'], 0)
+                    if version >= 3:
+                        findings = expected['properties']['findings']['items']['properties']
+                        commit = findings['locations']['items']['properties']['commit']
+                        self.assertEqual(commit.pop('enum'), [task, ancestor])
+                    self.assertEqual(provider_output_schema(manifest), expected)
+                    self.assertEqual(output_schema(manifest), full)
