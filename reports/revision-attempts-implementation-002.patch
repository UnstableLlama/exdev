diff --git a/teacher/revision.py b/teacher/revision.py
new file mode 100644
index 0000000..fe6d20f
--- /dev/null
+++ b/teacher/revision.py
@@ -0,0 +1,344 @@
+# SPDX-License-Identifier: MIT
+"""Reviewer-assisted revision: the teacher rewrites its own rejected entry.
+
+The teacher receives only its own previous annotation, that attempt's tool
+call/result records and a pointer-only coverage request. Verdicts, review
+files, ledger material, earlier prompts, commentary and other attempts never
+enter its input. The new transcript records only calls the new session made;
+imported records live in prior-evidence.json under a reserved ID namespace.
+"""
+import hashlib
+import json
+import os
+import re
+from pathlib import Path
+from .coverage_request import INSTRUCTION as COVERAGE_INSTRUCTION
+from .editorial import render
+from .session import FreshSession
+from .validation_repair import verify_final
+
+ROOT = Path(__file__).resolve().parents[1]
+VERSION = 1
+PRIOR_ARTIFACTS = ('draft.json', 'draft.md', 'raw-transcript.json', 'provenance.json')
+RESERVED = 'prior:'
+INSTRUCTION = (
+    'You are revising your own previous annotation for this position. The historical packet is unchanged. '
+    'The supplied previous annotation and tool records belong only to the named prior attempt. Write a '
+    'complete replacement annotation using the ordinary editorial schema; do not return a patch. Keep the '
+    'mechanisms and supported findings that the previous annotation established, examine the supplied '
+    'pointer-only coverage request, and correct any claims you find unsupported. Cite every retained or '
+    'added statement using a supplied prior evidence ID or a new tool evidence ID. Previous prose itself is '
+    'not evidence. Prior tool records describe checks performed in the previous attempt, not checks newly '
+    'executed in this session; preserve their source/execution distinctions and limitations. New findings '
+    'and changes must be supported by permitted historical evidence. Nobody else will edit your prose. Do '
+    'not mark this entry approved, canonical, or training eligible.')
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def read_regular(path):
+    path = Path(path)
+    if path.is_symlink() or not path.is_file():
+        raise ValueError('Revision inputs must be regular files: ' + path.name)
+    return path.read_bytes()
+
+
+def relative(path):
+    path = Path(path).resolve()
+    return str(path.relative_to(ROOT)) if path.is_relative_to(ROOT) else str(path)
+
+
+def located(path):
+    path = Path(path)
+    return path if path.is_absolute() else ROOT/path
+
+
+def prefix_for(transcript_sha256):
+    return RESERVED + transcript_sha256[:16] + ':'
+
+
+def prior_records(transcript, transcript_sha256):
+    """Deterministic import of every call/result pair, in call order. No prose, no commentary."""
+    prefix = prefix_for(transcript_sha256)
+    calls, order, results = {}, [], {}
+    for message in transcript:
+        if message.get('role') == 'assistant':
+            for call in message.get('calls', []):
+                if (set(call) != {'id', 'tool', 'arguments'} or not isinstance(call['id'], str) or not call['id']
+                        or call['id'] in calls or call['id'].startswith((RESERVED, 'ancestor:'))):
+                    raise ValueError('Prior transcript call cannot be imported')
+                calls[call['id']] = call
+                order.append(call['id'])
+        elif message.get('role') == 'tool':
+            identity = message.get('call_id')
+            if (identity not in calls or identity in results or message.get('name') != calls[identity]['tool']
+                    or not isinstance(message.get('content'), str)):
+                raise ValueError('Prior transcript result cannot be imported')
+            json.loads(message['content'])
+            results[identity] = message['content']
+    if set(results) != set(calls):
+        raise ValueError('Prior transcript has a call without a result')
+    return [{'id': prefix + identity, 'original_id': identity, 'tool': calls[identity]['tool'],
+             'arguments': calls[identity]['arguments'], 'content': results[identity],
+             'result_sha256': sha(results[identity].encode())} for identity in order]
+
+
+def check_document(document):
+    keys = {'version', 'revision_of_run', 'source_transcript_sha256', 'id_prefix', 'prior_artifact_sha256', 'records'}
+    if not isinstance(document, dict) or set(document) != keys or document['version'] != VERSION:
+        raise ValueError('Unsupported imported evidence document')
+    digest = document['source_transcript_sha256']
+    if (not isinstance(digest, str) or not re.fullmatch(r'[0-9a-f]{64}', digest)
+            or document['id_prefix'] != prefix_for(digest)
+            or set(document['prior_artifact_sha256']) != set(PRIOR_ARTIFACTS)
+            or document['prior_artifact_sha256']['raw-transcript.json'] != digest):
+        raise ValueError('Imported evidence is not bound to its source transcript')
+    seen = set()
+    for record in document['records']:
+        if (set(record) != {'id', 'original_id', 'tool', 'arguments', 'content', 'result_sha256'}
+                or record['id'] != document['id_prefix'] + record['original_id'] or record['id'] in seen
+                or sha(record['content'].encode()) != record['result_sha256']):
+            raise ValueError('Fabricated, duplicate or altered imported evidence record')
+        seen.add(record['id'])
+    return document
+
+
+def view(document):
+    """Imported records in transcript shape, for the validators only. Never saved as the new transcript."""
+    messages = []
+    for record in check_document(document)['records']:
+        messages.append({'role': 'assistant', 'calls': [
+            {'id': record['id'], 'tool': record['tool'], 'arguments': record['arguments']}]})
+        messages.append({'role': 'tool', 'name': record['tool'], 'call_id': record['id'], 'content': record['content']})
+    return messages
+
+
+def remap(annotation, mapping):
+    """Rewrite citation fields only. Prose and every other string stay byte-identical."""
+    result = json.loads(json.dumps(annotation))
+    def fixed(references):
+        output = []
+        for reference in references:
+            if reference.startswith('ancestor:'):
+                output.append(reference)
+            elif reference in mapping:
+                output.append(mapping[reference])
+            else:
+                raise ValueError('Prior annotation cites an unknown evidence call')
+        return output
+    claims = [claim for field in ('problem', 'reasoning', 'impact', 'source_notes') for claim in result[field]]
+    claims += [claim for chapter in result['chapters'] for claim in chapter['claims']]
+    for claim in claims:
+        claim['evidence'] = fixed(claim['evidence'])
+    for finding in result.get('findings', []):
+        finding['source_evidence'] = fixed(finding['source_evidence'])
+        for check in finding['verification']:
+            check['evidence'] = fixed(check['evidence'])
+    return result
+
+
+def prior_document(prior_run, packet):
+    """Bind the rejected attempt and extract its annotation mechanically. Reads exactly four files."""
+    prior_run, packet = Path(prior_run).resolve(), Path(packet).resolve()
+    if (prior_run/'prior-evidence.json').exists():
+        raise ValueError('A revision cannot itself be revised without a new request')
+    raw = {name: read_regular(prior_run/name) for name in PRIOR_ARTIFACTS}
+    provenance = json.loads(raw['provenance.json'])
+    transcript = json.loads(raw['raw-transcript.json'])
+    draft = json.loads(raw['draft.json'])
+    manifest_bytes = read_regular(packet/'manifest.json')
+    manifest = json.loads(manifest_bytes)
+    if provenance.get('attempt_kind') == 'revision':
+        raise ValueError('A revision cannot itself be revised without a new request')
+    if provenance.get('trial_only') or '.teacher/trials' in str(prior_run):
+        raise ValueError('Trial runs cannot be revised')
+    if provenance.get('packet_manifest_sha256') != sha(manifest_bytes):
+        raise ValueError('Revision requires the byte-identical original packet')
+    if draft.get('sha') != manifest['task_sha']:
+        raise ValueError('Prior attempt belongs to another commit')
+    if manifest.get('coverage_request'):
+        raise ValueError('Packet already carries a coverage attachment; stop for review')
+    if manifest.get('authoring_task'):
+        raise ValueError('Chapter tasks are not revised by this route')
+    finals = [m['content'] for m in transcript if m.get('role') == 'assistant' and 'content' in m]
+    if not finals:
+        raise ValueError('Prior attempt has no final annotation')
+    try:
+        annotation = json.loads(finals[-1])
+    except ValueError as error:
+        raise ValueError('Prior final annotation cannot be extracted') from error
+    if annotation != draft.get('annotation'):
+        raise ValueError('Prior final annotation is ambiguous or differs from its saved draft')
+    entry, _ = verify_final(annotation, manifest, transcript, provenance)
+    if entry != draft or render(draft).encode() != raw['draft.md']:
+        raise ValueError('Prior annotation does not reproduce its saved draft')
+    digest = sha(raw['raw-transcript.json'])
+    document = {'version': VERSION, 'revision_of_run': relative(prior_run), 'source_transcript_sha256': digest,
+                'id_prefix': prefix_for(digest), 'prior_artifact_sha256': {name: sha(raw[name]) for name in PRIOR_ARTIFACTS},
+                'records': prior_records(transcript, digest)}
+    return check_document(document), annotation
+
+
+def admit_coverage(path, expected_sha256, manifest, run_name):
+    """Exact-bytes gate. The trusted admitter must already have refused conclusions and hindsight;
+    this screen additionally refuses evidence IDs and abbreviated commit IDs, which are facts by form."""
+    path = Path(path)
+    if path.is_symlink() or path.name != run_name + '.coverage.md' or not re.fullmatch(r'commit-\d{6}-\d{3}\.coverage\.md', path.name):
+        raise ValueError('Only a separate coverage request for this attempt is permitted')
+    raw = read_regular(path)
+    if not raw or len(raw) > 16384 or sha(raw) != expected_sha256:
+        raise ValueError('Coverage request missing, oversized or not explicitly approved')
+    text = raw.decode('utf-8')
+    allowed = set(manifest['commits']) | {manifest['task_sha']}
+    for commit in re.findall(r'\b[0-9a-f]{40}\b', text):
+        if commit not in allowed:
+            raise ValueError('Coverage request names a non-ancestor commit')
+    if (re.search(r'call_[0-9A-Za-z]{6,}|prior:[0-9a-f]{16}:', text)
+            or re.search(r'(?<![0-9A-Za-z])(?=[0-9a-f]*[0-9])(?=[0-9a-f]*[a-f])[0-9a-f]{7,39}(?![0-9A-Za-z])', text)):
+        raise ValueError('Coverage request cites evidence or an abbreviated commit; pointers only')
+    return text
+
+
+class RevisionSession(FreshSession):
+    """A fresh thread whose input adds the prior annotation, prior tool records and the coverage request."""
+    def __init__(self, packet, document, annotation, coverage_text):
+        super().__init__(packet)
+        task = json.loads(self.initial[1]['content'])
+        if 'reviewer_coverage_request' in task or 'revision' in task or 'evidence_index' not in task:
+            raise ValueError('Packet cannot take a revision attachment')
+        records = check_document(document)['records']
+        task['reviewer_coverage_request'] = coverage_text
+        task['revision'] = {
+            'previous_annotation': remap(annotation, {r['original_id']: r['id'] for r in records}),
+            'prior_tool_records': [{'tool': r['tool'], 'arguments': r['arguments'],
+                                    'result': dict(json.loads(r['content']), evidence_id=r['id'])} for r in records]}
+        self.initial = [{'role': 'system', 'content': self.initial[0]['content'] + '\n' + COVERAGE_INSTRUCTION + '\n' + INSTRUCTION},
+                        {'role': 'user', 'content': json.dumps(task, sort_keys=True)}]
+        self.prior_evidence = view(document)
+
+
+def input_sha256(session):
+    return sha(json.dumps(session.initial, sort_keys=True).encode())
+
+
+def new_call_count(transcript):
+    return sum(len(m.get('calls', [])) for m in transcript if m.get('role') == 'assistant')
+
+
+def coverage_report(packet, manifest, transcript, prior):
+    """Fresh runs get exactly run_coverage; a revision counts imported reads and says so."""
+    from .coverage import run_coverage
+    report = run_coverage(packet, manifest, [*prior, *transcript])
+    if prior:
+        report['revision'] = {'imported_calls': len(prior)//2, 'new_calls': new_call_count(transcript)}
+    return report
+
+
+def prior_view(run):
+    """Imported evidence for a saved run: [] unless the run is a recorded revision. Fails closed on any mismatch."""
+    run = Path(run)
+    provenance = json.loads(read_regular(run/'provenance.json'))
+    revision = provenance.get('attempt_kind') == 'revision'
+    path = run/'prior-evidence.json'
+    if not path.exists() and not path.is_symlink():
+        if revision:
+            raise ValueError('Revision run lacks its imported evidence')
+        return []
+    if not revision:
+        raise ValueError('Imported evidence on a run not recorded as a revision')
+    raw = read_regular(path)
+    if sha(raw) != provenance.get('prior_evidence_sha256'):
+        raise ValueError('Imported evidence differs from provenance')
+    return view(json.loads(raw))
+
+
+def reservation_path(prior_run, directory=None):
+    return Path(directory or ROOT/'.teacher/admin/revisions')/(Path(prior_run).name + '.json')
+
+
+def reserve(prior_run, record, directory=None):
+    """One revision per rejected attempt. Exclusive create; never freed by a failure."""
+    path = reservation_path(prior_run, directory)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    try:
+        handle = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
+    except FileExistsError:
+        raise ValueError('This attempt already has a revision reservation; a new request is required') from None
+    with os.fdopen(handle, 'w') as file:
+        file.write(json.dumps(dict(record, status='reserved'), indent=2) + '\n')
+    return path
+
+
+def settle(path, record, status):
+    pending = path.with_suffix('.json.new')
+    pending.write_text(json.dumps(dict(record, status=status), indent=2) + '\n')
+    pending.replace(path)
+
+
+def author_revision(packet, output, auth_file, *, prior_run, coverage, coverage_sha256, authorization,
+                    authorization_sha256, transport_factory=None, reservations=None):
+    """Supervisor-only entry point. Ordinary author stays fresh and unchanged."""
+    from .author import _author
+    from .codex_transport import CodexTransport
+    packet, output, prior_run = Path(packet).resolve(), Path(output).resolve(), Path(prior_run).resolve()
+    name = re.fullmatch(r'(commit-\d{6})-\d{3}', output.name)
+    if not name or not prior_run.name.startswith(name.group(1) + '-') or prior_run == output or output.exists():
+        raise ValueError('Revision must be a new attempt at the same position')
+    if sha(read_regular(authorization)) != authorization_sha256:
+        raise ValueError('Missing or changed revision authorization')
+    manifest = json.loads(read_regular(packet/'manifest.json'))
+    document, annotation = prior_document(prior_run, packet)
+    text = admit_coverage(coverage, coverage_sha256, manifest, output.name)
+    session = RevisionSession(packet, document, annotation, text)
+    evidence = (json.dumps(document, indent=2) + '\n').encode()
+    provenance = {'attempt_kind': 'revision', 'reviewer_assisted': True, 'revision_of_run': document['revision_of_run'],
+                  'prior_artifact_sha256': document['prior_artifact_sha256'], 'prior_evidence_sha256': sha(evidence),
+                  'prior_evidence_id_map_version': VERSION,
+                  'coverage_request': {'path': relative(coverage), 'sha256': coverage_sha256},
+                  'revision_input_sha256': input_sha256(session)}
+    # Authorization is administrative: bound here, never placed in provenance or teacher input.
+    record = {'revision_of_run': document['revision_of_run'], 'run': relative(output),
+              'coverage_request': provenance['coverage_request'], 'prior_evidence_sha256': sha(evidence),
+              'authorization': {'path': relative(authorization), 'sha256': authorization_sha256}}
+    reservation = reserve(prior_run, record, reservations)
+    try:
+        result = _author(packet, output, auth_file, transport_factory or CodexTransport,
+                         revision={'session': session, 'provenance': provenance, 'files': {'prior-evidence.json': evidence}})
+    except BaseException:
+        settle(reservation, record, 'failed')
+        raise
+    settle(reservation, record, 'draft')
+    return result
+
+
+def verify_run(run, packet):
+    """Re-derive everything the teacher was given from the bound files. Returns the imported document."""
+    run, packet = Path(run).resolve(), Path(packet).resolve()
+    provenance = json.loads(read_regular(run/'provenance.json'))
+    if provenance.get('attempt_kind') != 'revision' or provenance.get('reviewer_assisted') is not True:
+        raise ValueError('Run is not a recorded reviewer-assisted revision')
+    raw = read_regular(run/'prior-evidence.json')
+    if sha(raw) != provenance.get('prior_evidence_sha256') or provenance.get('prior_evidence_id_map_version') != VERSION:
+        raise ValueError('Imported evidence differs from provenance')
+    document = check_document(json.loads(raw))
+    manifest_bytes = read_regular(packet/'manifest.json')
+    if provenance.get('packet_manifest_sha256') != sha(manifest_bytes):
+        raise ValueError('Revision requires the byte-identical original packet')
+    rebuilt, annotation = prior_document(located(document['revision_of_run']), packet)
+    if rebuilt != document or provenance.get('revision_of_run') != document['revision_of_run'] \
+            or provenance.get('prior_artifact_sha256') != document['prior_artifact_sha256']:
+        raise ValueError('Imported evidence does not reproduce from the prior attempt')
+    coverage = provenance.get('coverage_request') or {}
+    text = admit_coverage(located(coverage.get('path', '')), coverage.get('sha256'), json.loads(manifest_bytes), run.name)
+    session = RevisionSession(packet, document, annotation, text)
+    transcript = json.loads(read_regular(run/'raw-transcript.json'))
+    supplied = [{k: v for k, v in message.items() if k != 'teacher_runtime'} for message in transcript[:2]]
+    if supplied != session.initial or provenance.get('revision_input_sha256') != input_sha256(session):
+        raise ValueError('Saved revision input differs from the permitted inputs')
+    for message in transcript:
+        for call in message.get('calls', []):
+            if call['id'].startswith(RESERVED):
+                raise ValueError('New transcript uses the reserved prior-evidence namespace')
+    return document
