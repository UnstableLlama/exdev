          "-c",
          "import itertools\nE=('token_embd.weight',200,100); H=('output.weight',100,100); W=('blk.0.attn_q.weight',50,100); N=('blk.0.attn_norm.weight',20,10)\ndef calc(ts,new):\n s=n=h=hn=0\n for name,b,e in ts:\n  if (name=='token_embd.weight' and h==0) or name=='output.weight': h=b*8/e; hn=e\n  elif name.endswith('.weight') and (not new or (name!='token_embd.weight' and not name.endswith('norm.weight'))): s+=b*8;n+=e\n return s/n,h,hn*h+s\nfor ts in [(E,H,W,N),(H,E,W,N),(E,W,N)]:print([x[0] for x in ts],calc(ts,False),calc(ts,True))\nprint('new results across 24 permutations:',set(calc(p,True) for p in itertools.permutations([E,H,W,N])))"
