+    if len(joined.encode()) <= budget:
+        return joined
+    shown = []
+    used = 0
+    for message in messages:
+        size = len(message.encode()) + (2 if shown else 0)
+        omitted = total - len(shown) - 1
+        footer_size = 2 + len(count_note.encode()) if omitted else 0
+        if used + size + footer_size > budget:
