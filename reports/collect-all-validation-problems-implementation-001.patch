+def bounded_problems(messages):
+    """Keep a prefix of whole diagnostics and account for every omitted item."""
+    total = len(messages)
+    count_note = f'Total validation problems: {total}. Omitted: {total}.'
+    suffix_bytes = len(('\n' + COLLECT_ALL_SENTENCE).encode())
