        "argv": [
          "python3",
          "-c",
          "def check(d,b):\n    W=[[(i%7)-3,(i%5)-2] for i in range(d)]\n    E=[[i%3-1,i%4-2] for i in range(d)]\n    # Symmetric positive definite: 3I plus the all-ones matrix; nonzero across blocks.\n    def span(A,lo,hi):\n        return sum(A[i][k]*(1+3*(i==j))*A[j][k] for i in range(d) for j in range(lo,hi) for k in range(2))\n    blocks=[(s,min(s+b,d)) for s in range(0,d,b)]\n    full=[span(A,0,d) for A in (E,W)]\n    chunk=[sum(span(A,s,t) for s,t in blocks) for A in (E,W)]\n    assert full==chunk\n    print(d,b,[(t-s) for s,t in blocks],full,chunk,full[0]/max(full[1],1e-8))\ncheck(7,3)\ncheck(1025,1024)\nlimits=[0.5,0.1,0.05,0.01,0.005,0.005,0.005,0.005]\nprint('sentinel passes',sum(-1.0<x for x in limits),'of',len(limits))"
        ]
      }
    }
