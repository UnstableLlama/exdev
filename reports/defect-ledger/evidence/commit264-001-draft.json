        "claims": [
          {
            "text": "Each changed file replaces only its first-line import with from typing_extensions import override. The decorator remains on default_chat_prompt; constructors, Llama inheritance, architecture identifiers and prompt strings are unchanged.",
            "basis": "source",
            "evidence": [
              "call_933a0b0e27934d308410e89df78040c8",
              "call_24439aea84224d2f97c8c82e9796ecca",
