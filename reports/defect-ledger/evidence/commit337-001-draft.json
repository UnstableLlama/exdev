    "call_a403aa1befb945d9b6cf5082b1978b50": {
      "tool": "run",
      "arguments": {
        "argv": [
          "python3",
          "-c",
          "import ast,copy,pathlib,types\np=pathlib.Path('exllamav3/models'); names='cohere cohere2 decilm dots1 ernie4_5 ernie4_5_moe exaone4 gemma2 gemma3 glm4 llama mistral3 mixtral phi3 qwen3 qwen3_moe smollm3'.split()\ndef node(path,name):\n return next(n for n in ast.walk(ast.parse(path.read_text())) if isinstance(n,ast.FunctionDef) and n.name==name)\nattn=pathlib.Path('exllamav3/modules/attn.py')\nns={'torch':types.SimpleNamespace(Tensor=object)}\ndef build(fn):\n fn.decorator_list=[]\n exec(compile(ast.fix_missing_locations(ast.Module(body=[fn],type_ignores=[])), '<isolated-method>', 'exec'),ns)\n return ns[fn.name]\nfor name in ['prepare_sdpa_nc','prepare_flash_attn_nc','prepare_flash_attn','prepare_for_attn']: build(node(attn,name))\nids=types.SimpleNamespace(shape=(2,3)); stale=object(); trials=0\nfor name in names:\n fn=node(p/(name+'.py'),'prepare_inputs'); new=copy.deepcopy(fn)\n assert ast.unparse(new.body.pop(0))==\"params['input_ids'] = input_ids\"\n old=build(fn); changed=build(new)\n for metadata in ({},{'attn_mode':'sdpa_nc'},{'attn_mode':'flash_attn','block_table':object(),'cache_seqlens':object()}):\n  for initial in ({},{'input_ids':stale}):\n   a=metadata|initial; b=a.copy()\n   assert old(None,ids,a) is changed(None,ids,b) is ids\n   assert a.pop('input_ids') is ids and b.get('input_ids') is initial.get('input_ids')\n   b.pop('input_ids',None); assert a==b\n   trials+=1\nbase=build(node(p/'model.py','prepare_inputs')); d={}; assert base(None,ids,d) is ids and d['input_ids'] is ids\nprint(f'{len(names)} overrides, {trials} paired cases: same object and same other metadata; fresh key omitted and supplied key left untouched; base still writes key')"
        ]
      },
      "result_sha256": "2bad974b66e39b8cb37c9bff603408e81a6e4be7b5a4e32e4593c7ac25ac6638"
    },
