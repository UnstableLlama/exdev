          "call_7a3f6621e1fd434ca79b4947736c868f"
        ]
      }
    ],
    "reasoning": [
      {
        "text": "Removing the trailing False restores the existing native interface rather than introducing a new routing option. The native implementation reads activate_all_experts from params.",
        "basis": "source",
        "evidence": [
          "call_4fe7f9c7606741fbb0abae986c908a1b",
          "call_d0d382ff63034220bf89a3197c9b85b1"
        ]
      }
    ],
    "impact": [
      {
        "text": "Mixtral and Qwen3 MoE use the default native route and therefore benefit from the repaired call. Dots1 explicitly selects the separate single-group Dots router, so this edit does not change its routing call.",
        "basis": "source",
        "evidence": [
          "call_9c8c59743f5b4bf797cf149d6b5c4b38",
          "call_db7d0d84c39c433caa6b47c2121c56cd",
