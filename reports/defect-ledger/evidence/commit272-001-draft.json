  "annotation": {
    "schema_version": 5,
    "type": "bugfix",
    "problem": [
      {
        "text": "The default BlockSparseMLP route supplied five arguments to a native function declared, implemented and bound with four parameters.",
        "basis": "source",
        "evidence": [
          "call_4fe7f9c7606741fbb0abae986c908a1b",
          "call_1ce9fed7d73246388a9a6cc3e21f1645",
