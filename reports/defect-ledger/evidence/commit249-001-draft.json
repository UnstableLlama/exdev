            "evidence": [
              "call_a80078dda88d4adc823fa7f0246923e1"
            ],
            "limits": "Checks string structure only, not tokenizer recognition or generation behavior."
          }
        ]
      }
    ],
    "summary": "Adds architecture-default single-round prompt formatting without changing existing chat callers. The Gemma implementations appear to lose supplied system content and omit user-turn closure."
  },
