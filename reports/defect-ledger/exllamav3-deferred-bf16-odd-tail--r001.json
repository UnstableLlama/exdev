      ],
      "limits": "No affected model checkpoint or GPU execution was demonstrated."
    },
    {
      "method": "scalar_transcription",
      "description": "Python modeled the inspected chunking and pair-count expressions. Counts 1, 3, 2049 and 4194305 each leave one element uncovered, while 2 leaves none. Interpreting the illustrative BF16-one bit pattern 0x3f80 as binary16 yields 1.875 instead of 1.0.",
      "evidence": [
        "call_224f301938ae469187458cff3877948c",
        "call_2f06887d239a406ebdfa34a455e54be0"
      ],
      "limits": "This checks finite integer indexing and bit interpretation, not the repository kernel, CUDA launch behavior or floating-point conversion implementation."
    }
