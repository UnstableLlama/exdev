{
  "origin": "authoring_observation",
  "classification": "defect",
  "status": "suspected",
  "description": "A new Hopper/Blackwell selector condition compares a Boolean expression with 8192, making its shape-3 arm unreachable.",
  "trigger": "Automatic selection reaches the non-eight-bit size_n <= 4096 branch after bypassing the earlier shape-1 condition; for example bits=3, size_k=16384, size_n=4096.",
  "expected_behavior": "If this ternary is intended to distinguish a dimension threshold, its condition should compare a dimension rather than a Boolean. The precise intended rule is unestablished.",
  "actual_behavior": "(size_k && bits >= 3) is zero or one, so comparison with 8192 is always false and the branch returns shape 2. This reaches automatic direct-GEMM calls from LinearEXL3.forward and the benchmark's preferred-shape query; forced positive shape indices bypass it.",
  "verification": [
    {
      "method": "source_inspection",
      "description": "Inspected the new selector, host dispatch and updated callers. Whole-parent search finds no previous select_gemm_shape symbol and identifies direct GEMM Python call sites.",
      "evidence": [
        "call_a46bf35565a64c97b4686ff4280cc9b9",
        "call_7fb8193f7d944fd58205863153f52e28",
        "call_c331115211bc4a0390af66dea74a9281",
        "call_349c6d091db34c72befe32bd4bc42376"
      ],
      "limits": "No runtime performance consequence established; external callers were not enumerated."
    },
    {
      "method": "scalar_transcription",
      "description": "Python modeled the Boolean comparison for k=4096, 16384 and 32768 with representative bitrates; every result was false.",
      "evidence": [
        "call_d3cab3b4c1d14ad5ba6f59fab37b8a01"
      ],
      "limits": "Expression check only, not repository or GPU execution."
    }
