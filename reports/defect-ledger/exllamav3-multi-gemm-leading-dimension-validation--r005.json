{
  "origin": "authoring_observation",
  "classification": "defect",
  "status": "suspected",
  "description": "The wrapper accepts leading-dimension combinations that the kernel's maximum-length traversal cannot safely consume.",
  "trigger": "For otherwise suitable contiguous tensors, use A leading dimension 2, C leading dimension 1 and indices shape (1,1); alternatively use leading dimensions 2 and 3 with indices shape (1,3).",
  "expected_behavior": "Reject incompatible dimensions or ensure every iteration has valid input, scratch and index storage.",
  "actual_behavior": "The first case passes the indices-width check but reads B_indices[1] beyond the one-element tensor. The second advances A to a nonexistent third input matrix. The wrapper does not validate the leading-dimension relationship. Reach established here is the newly exported exl3_mgemm binding; the whole-parent search found no existing literal callers. At 135, output offset becomes unconditional: with input/output leading dimensions 2 and 1 the second result also writes beyond C, rather than overwriting the shared output. The existing out-of-range index read remains.",
  "verification": [
    {
      "method": "scalar_transcription",
      "description": "Modeled the wrapper's indices-width equality, maximum iteration count and input advancement for four leading-dimension combinations.",
      "evidence": [
        "call_a30c71f03a4143f39a1a13fed4dc3f3a"
      ],
      "limits": "Checks address-index bounds symbolically, not CUDA execution or the resulting device failure."
    },
    {
      "method": "reviewer_source_inspection",
      "description": "135 verdict confirms additional output-buffer overrun for the existing incompatible leading dimensions.",
      "limits": "Source-only; no GPU access or failure observed."
    }
  ],
