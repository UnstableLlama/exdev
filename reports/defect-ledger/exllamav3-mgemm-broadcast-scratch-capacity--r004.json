      "finding": {
        "id": "broadcast-scratch-capacity-unchecked",
        "origin": "authoring_observation",
        "status": "suspected",
        "classification": "defect",
        "description": "The earlier per-matrix scratch requirement remains unchecked.",
        "trigger": "Supply one broadcast input, more than one active matrix and A_had with room for only the input's single matrix.",
        "expected_behavior": "Reject insufficient scratch or manage scratch so every transform uses a valid slot.",
        "actual_behavior": "The kernel broadcasts A but writes and reads scratch at j * size_m * size_k. The cap does not check scratch storage. The inspected K/V and routed-expert call sites allocate scratch per projection or configured expert slot; the undersized-scratch case is established at the extension interface, not those calls.",
        "locations": [
          {
