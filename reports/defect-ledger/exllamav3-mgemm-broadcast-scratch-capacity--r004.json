      "finding": {
        "id": "retained-multi-gemm-broadcast-scratch-contract",
        "origin": "authoring_observation",
        "status": "suspected",
        "classification": "new_requirement",
        "description": "Broadcasting one input matrix does not broadcast its transformed-input scratch slice.",
        "trigger": "A multi-GEMM binding caller supplies one input, multiple active outputs, and scratch sized only like the input, as the wrapper comment suggests.",
        "expected_behavior": "Document and validate one scratch slice per active matrix, or make input-sized scratch sufficient.",
        "actual_behavior": "The kernel advances the scratch pointer by M\u00d7K elements per matrix even when it reuses A. The wrapper does not check that capacity. Fused K/V and expert gate/up allocate per-matrix scratch; fused down uses paired matrices with matching scratch.",
        "locations": [
          {
            "commit": "e14fa3cf22ff9c4203736690522c7baaf17dd57b",
            "path": "exllamav3/exllamav3_ext/quant/exl3_gemm_kernel.cuh",
