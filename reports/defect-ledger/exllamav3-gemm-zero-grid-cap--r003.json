{
  "origin": "authoring_observation",
  "classification": "defect",
  "status": "suspected",
  "description": "The selector can cap the cooperative grid at zero for small matrices; multi-GEMM later divides by that zero cap.",
  "trigger": "Call exl3_mgemm with shape 2 forced, size_k=128 and size_n=128: the selector computes (128/32)*(128/128)/12 = 0.",
  "expected_behavior": "Reject unsupported small workloads explicitly or retain a positive launch width.",
  "actual_behavior": "The selector sets num_sms to zero and the new host expression evaluates total_sms / num_sms before launch. The prior zero-width launch problem is changed into an integer-division-by-zero path. Reach is the native interface exposed by the extension; no Python caller was found.",
  "verification": [
    {
      "method": "scalar_transcription",
      "description": "Evaluated the selector's bounded tile-count arithmetic and obtained zero.",
      "evidence": [
        "call_0adc900e5b3446168adcc5f1c4bf01a4"
      ],
      "limits": "Did not execute C++ division or launch CUDA; runtime failure manifestation is unmeasured."
    }
  ],
