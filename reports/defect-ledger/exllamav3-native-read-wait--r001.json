{
  "origin": "authoring_observation",
  "classification": "defect",
  "status": "suspected",
  "description": "The existing native disk fallback can leave its GPU copy worker waiting after a read failure.",
  "trigger": "A GPU-target mt_fread load has a copy worker waiting on an empty queue when a reader fails, with no subsequent successful enqueue.",
  "expected_behavior": "The failure should wake the copy worker and allow the loader to report its I/O error.",
  "actual_behavior": "The reader only sets load_failed; the wait predicate checks only queue nonemptiness and receives no failure notification, so thread joining may not complete.",
  "verification": [
