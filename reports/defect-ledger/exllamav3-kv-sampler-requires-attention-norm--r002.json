      "finding": {
        "id": "kv-sampler-still-requires-attention-norm",
        "origin": "authoring_observation",
        "status": "suspected",
        "classification": "external_compatibility",
        "description": "The KV research sampler reconstructs the pre-attention path directly and does not inherit TransformerBlock.forward's fallback.",
        "trigger": "Use sample_qkv on a model whose targeted TransformerBlock has active attention but attn_norm=None, and reach that target rather than returning cached samples.",
        "expected_behavior": "If the sampler is to accept this block shape, it should project from the same FP16 residual input as the block.",
        "actual_behavior": "It calls module.attn_norm.forward directly and would raise AttributeError before projecting or reaching module.forward.",
        "locations": [
          {
            "commit": "ba4304a44b267e88f3c882136302fd1e25c5384e",
            "path": "science/kv_quant_exp.py",
            "symbol": "sample_qkv"
          }
        ],
