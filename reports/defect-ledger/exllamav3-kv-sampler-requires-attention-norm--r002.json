      "finding": {
        "id": "research-sampler-bypasses-normless-fallback",
        "origin": "authoring_observation",
        "status": "suspected",
        "classification": "external_compatibility",
        "description": "The inherited sampler precondition now excludes the normless EXAONE4 blocks.",
        "trigger": "Point sample_qkv at an otherwise loadable EXAONE4 model and reach an uncached target layer.",
        "expected_behavior": "A compatible sampler would use the same FP16 branch input as the block, apply Q/K normalization, and handle the absence of global-layer RoPE.",
        "actual_behavior": "The sampler dereferences module.attn_norm.forward on None before it can call block.forward. Its later direct RoPE call is also unconditional, so adding only the input cast would not handle a global target.",
