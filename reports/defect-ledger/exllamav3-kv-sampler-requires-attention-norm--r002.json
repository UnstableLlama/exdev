        ],
        "verification": [
          {
            "method": "source_inspection",
            "description": "Located the direct norm reader and traced the script's top-level sample_qkv call and target-layer branch.",
            "evidence": [
              "call_753685cb3bb44a70aeb5279cce60720c",
              "call_c2efcac45b744aca835dc2d3df4d13b8"
            ],
            "limits": "The script targets a Llama checkpoint by default, and the inspected Llama builder supplies the norm. No failure is established for that default."
          }
