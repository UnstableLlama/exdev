            "symbol": "convert_dtype"
          }
        ],
        "source_evidence": [
          "call_4df611a1a55e4b06abd1e1067e8526e0",
          "call_7b2093a566444ba890430ad0d6f037ff",
          "call_db36d70c67da40ff957ccd8dfb627c03"
        ],
        "verification": [
          {
            "method": "source_inspection",
            "description": "Traced the sole parent-tree load_fp16 caller, Linear.load, through get_tensor to dtype conversion. The restriction affects file-backed FP8 loads, not necessarily injected new_tensors.",
