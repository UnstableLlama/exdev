          "-c",
          "import math,random\nr=random.Random(0); err=0; n=0\nfor E in (2,8,64):\n for k in (1,E//2,E):\n  for _ in range(100):\n   z=[r.uniform(-20,20) for i in range(E)]; ix=sorted(range(E),key=lambda i:z[i],reverse=True)[:k]\n   a=[math.exp(v-max(z)) for v in z]; p=[v/sum(a) for v in a]; old=[p[i]/sum(p[j] for j in ix) for i in ix]\n   b=[math.exp(z[i]-max(z[j] for j in ix)) for i in ix]; new=[v/sum(b) for v in b]\n   err=max(err,max(abs(x-y) for x,y in zip(old,new))); n+=1\nprint({'cases':n,'max_abs_error':err,'all_expert_indices':8,'fused_output_experts':2})"
