{
  "schema_version": 1,
  "status": "frozen",
  "cutoff_policy": "Trusted caller supplies an immutable cutoff outside model arguments; every commit must be that cutoff or an ancestor.",
  "tools": [
    {
      "name": "graph_search",
      "description": "Find indexed symbols at an authorized historical commit.",
      "parameters": {
        "type": "object",
        "properties": {
          "commit": {
            "type": "string",
            "minLength": 1
          },
          "name_pattern": {
            "type": "string",
            "default": "*"
          },
          "kind": {
            "type": "string"
          },
          "file_pattern": {
            "type": "string",
            "default": "*"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        },
        "required": [
          "commit"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "graph_trace",
      "description": "Trace calls, including evidence-bearing native binding edges.",
      "parameters": {
        "type": "object",
        "properties": {
          "commit": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "enum": [
              "outbound",
              "inbound",
              "both"
            ],
            "default": "outbound"
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15,
            "default": 2
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 100
          }
        },
        "required": [
          "commit",
          "symbol"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "graph_query",
      "description": "Read-only Cypher over the pinned backend snapshot plus evidence-bearing supplemental binding edges.",
      "parameters": {
        "type": "object",
        "properties": {
          "commit": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        },
        "required": [
          "commit",
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "symbol_history",
      "description": "Return exact-qualified-name events within the selected commit ancestry.",
      "parameters": {
        "type": "object",
        "properties": {
          "commit": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 100
          }
        },
        "required": [
          "commit",
          "symbol"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "repo_map",
      "description": "PageRank outline with a conservative UTF-8 byte budget as a token-count upper bound.",
      "parameters": {
        "type": "object",
        "properties": {
          "commit": {
            "type": "string",
            "minLength": 1
          },
          "token_budget": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32000,
            "default": 2000
          }
        },
        "required": [
          "commit"
        ],
        "additionalProperties": false
      }
    }
  ]
}
