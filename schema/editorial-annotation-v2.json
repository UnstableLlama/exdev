{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "type": {
      "type": "string",
      "enum": [
        "bugfix",
        "new architecture support",
        "performance",
        "refactor",
        "feature",
        "docs",
        "noise",
        "integration"
      ]
    },
    "problem": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "basis": {
            "type": "string",
            "enum": [
              "source",
              "execution",
              "inference"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 64
          }
        },
        "required": [
          "text",
          "basis",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "reasoning": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "basis": {
            "type": "string",
            "enum": [
              "source",
              "execution",
              "inference"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 64
          }
        },
        "required": [
          "text",
          "basis",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "impact": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "basis": {
            "type": "string",
            "enum": [
              "source",
              "execution",
              "inference"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 64
          }
        },
        "required": [
          "text",
          "basis",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "source_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "basis": {
            "type": "string",
            "enum": [
              "source",
              "execution",
              "inference"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 64
          }
        },
        "required": [
          "text",
          "basis",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "maxItems": 128
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      },
      "maxItems": 128
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "source",
                    "execution",
                    "inference"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 64
                }
              },
              "required": [
                "text",
                "basis",
                "evidence"
              ],
              "additionalProperties": false
            },
            "maxItems": 128
          }
        },
        "required": [
          "id",
          "title",
          "claims"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    }
  },
  "required": [
    "schema_version",
    "type",
    "problem",
    "reasoning",
    "impact",
    "source_notes",
    "limitations",
    "links",
    "chapters"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exdev editorial annotation v2 candidate"
}
