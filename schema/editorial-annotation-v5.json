{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 5
    },
    "type": {
      "type": "string",
      "enum": [
        "bugfix",
        "new architecture support",
        "performance",
        "refactor",
        "feature",
        "docs",
        "noise",
        "integration"
      ]
    },
    "problem": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "basis": {
            "type": "string",
            "enum": [
              "source",
              "execution",
              "inference",
              "ancestor"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 64
          }
        },
        "required": [
          "text",
          "basis",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "reasoning": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "basis": {
            "type": "string",
            "enum": [
              "source",
              "execution",
              "inference",
              "ancestor"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 64
          }
        },
        "required": [
          "text",
          "basis",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "impact": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "basis": {
            "type": "string",
            "enum": [
              "source",
              "execution",
              "inference",
              "ancestor"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 64
          }
        },
        "required": [
          "text",
          "basis",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "source_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "basis": {
            "type": "string",
            "enum": [
              "source",
              "execution",
              "inference",
              "ancestor"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 64
          }
        },
        "required": [
          "text",
          "basis",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "maxItems": 128
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      },
      "maxItems": 128,
      "description": "Approved ancestor commit SHAs only. Never chapter IDs or external links. Empty for a root commit."
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "source",
                    "execution",
                    "inference",
                    "ancestor"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 64
                }
              },
              "required": [
                "text",
                "basis",
                "evidence"
              ],
              "additionalProperties": false
            },
            "maxItems": 128
          }
        },
        "required": [
          "id",
          "title",
          "claims"
        ],
        "additionalProperties": false
      },
      "maxItems": 32,
      "description": "Subsystem chapters within this one canonical entry. Their IDs are local anchors, not ancestor links."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,95}$"
          },
          "origin": {
            "type": "string",
            "const": "authoring_observation"
          },
          "status": {
            "type": "string",
            "const": "suspected"
          },
          "classification": {
            "type": "string",
            "enum": [
              "defect",
              "behavior_change",
              "new_requirement",
              "external_compatibility",
              "unresolved"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "trigger": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "expected_behavior": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "actual_behavior": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                }
              },
              "required": [
                "commit",
                "path",
                "symbol"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 32
          },
          "source_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 64
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "enum": [
                    "source_inspection",
                    "scalar_transcription",
                    "repository_execution"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "maxItems": 64
                },
                "limits": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                }
              },
              "required": [
                "method",
                "description",
                "evidence",
                "limits"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 16
          }
        },
        "required": [
          "id",
          "origin",
          "status",
          "classification",
          "description",
          "trigger",
          "expected_behavior",
          "actual_behavior",
          "locations",
          "source_evidence",
          "verification"
        ],
        "additionalProperties": false
      },
      "maxItems": 128,
      "description": "Cited authoring-time observations only; not confirmed retrospective labels. Use [] if none."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "required": [
    "schema_version",
    "type",
    "problem",
    "reasoning",
    "impact",
    "source_notes",
    "limitations",
    "links",
    "chapters",
    "findings",
    "summary"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exdev editorial annotation v3 candidate"
}
