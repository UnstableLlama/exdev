{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exdev mined commit record v1",
  "type": "object",
  "required": ["schema_version", "position", "sha", "parent_sha", "parent_shas", "author", "author_date", "commit_date", "message", "diff", "diff_sha256", "files_touched", "references", "type", "noise", "rights"],
  "properties": {
    "schema_version": {"const": 1},
    "position": {"type": "integer", "minimum": 1},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "parent_sha": {"type": ["string", "null"]},
    "parent_shas": {"type": "array", "items": {"type": "string"}},
    "author": {"type": "string"},
    "author_date": {"type": "string"},
    "commit_date": {"type": "string"},
    "message": {"type": "string"},
    "diff": {"type": "string"},
    "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files_touched": {"type": "array", "items": {"type": "string"}},
    "references": {"type": "object"},
    "type": {"enum": ["bugfix", "new architecture support", "performance", "refactor", "feature", "docs", "noise"]},
    "noise": {"type": "boolean"},
    "rights": {"type": "object"}
  }
}
