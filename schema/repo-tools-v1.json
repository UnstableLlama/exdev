            "minimum": 1,
            "maximum": 16384,
            "default": 16384
          },
          "file": {
            "type": "string",
            "default": ""
          },
          "symbol": {
            "type": "string",
            "default": ""
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          }
        },
