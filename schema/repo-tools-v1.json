    {
      "name": "ancestor_read",
      "description": "Read approved historical explanation prose in byte pages, or page its navigation catalog. Catalog metadata is not claim evidence. Cite the current read call ID, never an old session ID. Search mode finds navigation targets by case-sensitive file and/or symbol substring, mechanically indexed from approved assignments, Git changes, graph records and structured finding locations. The max_bytes cap is 16384 bytes (16 KiB), including content and catalog reads; use next_offset to continue. Do not request the 65536-byte cap used by some source tools.",
      "parameters": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "catalog",
              "content",
              "search"
            ]
          },
          "commit": {
            "type": "string",
            "default": ""
          },
          "chapter": {
            "type": "string",
            "default": ""
          },
          "offset": {
            "type": "integer",
