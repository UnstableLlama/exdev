  "annotation": {
    "schema_version": 5,
    "type": "bugfix",
    "problem": [
      {
        "text": "Attention stored its constructor out_dtype but did not pass it to the output projection. The requested dtype was applied only after decoding, rather than when allocating the projection result.",
        "basis": "source",
        "evidence": [
          "call_5c8822c954ca4231a9c1d5b505293a59",
          "call_71702caba2bb41a3a918c2c3e6dd2ad6"
        ]
      }
    ],
    "reasoning": [
      {
        "text": "Passing out_dtype into o_proj lets Linear propagate it to both FP16 and EXL3 implementations, whose forward methods use the configured dtype when allocating their output buffers.",
        "basis": "source",
        "evidence": [
          "call_c679d21ed8ce483a9ce928c486c3d647",
          "call_0864d627f3764d99897a444d98f4ff39",
          "call_69b03915055f49598dde4ecb546422b3",
          "call_89f93d59fa12456f8a436f102f370170"
        ]
      }
    ],
    "impact": [
      {
        "text": "The change covers all three attention backends because each calls project_o. With the constructor default of None, projection allocation still defaults to torch.half; Q/K/V projections are unchanged.",
        "basis": "source",
        "evidence": [
          "call_c679d21ed8ce483a9ce928c486c3d647",
          "call_5c8822c954ca4231a9c1d5b505293a59",
          "call_69b03915055f49598dde4ecb546422b3",
          "call_89f93d59fa12456f8a436f102f370170"
        ]
      }
    ],
    "source_notes": [
      {
        "text": "Issue #16, \u201cRuntimeError: CUDA error: invalid configuration argument,\u201d reports a conversion failure during Hessian capture; its discussion attributes that failure to tokenizer truncation. Its overlapping attention/linear traceback is not evidence that this dtype change fixes that report.",
        "basis": "source",
        "evidence": [
          "call_dee0ea3af2a2419fbef7338dc007cd35"
        ]
      }
    ],
    "limitations": [
      "No repository or GPU execution was performed; native dtype support, numerical improvements and performance effects were not verified.",
      "No useful scalar computation establishes this constructor-wiring change's GPU behavior."
    ],
    "links": [],
    "chapters": [
      {
        "id": "modules",
        "title": "Apply the configured dtype inside the attention output projection",
        "claims": [
          {
            "text": "project_o flattens the attention heads to num_q_heads \u00d7 head_dim and projects that dimension back to hidden_size. The patch changes only the projection's configured output dtype, not its dimensions, weight key or calibration qmap.",
            "basis": "source",
            "evidence": [
              "call_5c8822c954ca4231a9c1d5b505293a59",
              "call_c679d21ed8ce483a9ce928c486c3d647"
            ]
          },
          {
            "text": "Previously a float output request could widen an already half-precision projection result. Moving the configured dtype into the projection allows a wider destination before the final attention-level conversion, rather than relying on a cast to recover information already lost.",
            "basis": "inference",
            "evidence": [
              "call_69b03915055f49598dde4ecb546422b3",
              "call_89f93d59fa12456f8a436f102f370170",
              "call_71702caba2bb41a3a918c2c3e6dd2ad6",
              "call_c679d21ed8ce483a9ce928c486c3d647"
            ]
          },
          {
            "text": "Attention.forward's per-call out_dtype remains a final conversion override: it is not forwarded through project_o. The new internal allocation policy follows the constructor argument, while the final returned dtype can still be overridden per call.",
            "basis": "source",
            "evidence": [
              "call_5c8822c954ca4231a9c1d5b505293a59",
              "call_c679d21ed8ce483a9ce928c486c3d647",
              "call_71702caba2bb41a3a918c2c3e6dd2ad6"
            ]
          }
        ]
      }
    ],
    "findings": [],
    "summary": "Propagates Attention's configured output dtype into its output projection, instead of applying it only after projection."
  },
