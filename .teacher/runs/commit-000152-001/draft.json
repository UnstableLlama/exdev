        "id": "build-release",
        "title": "Propagating the 0.0.2 release identifier",
        "claims": [
          {
            "text": "setup.py executes version.py into a dictionary and passes its __version__ value to setup(version=...), so the edited constant supplies the package's new base version.",
            "basis": "source",
            "evidence": [
              "call_d63fab4ffe1645b490f5af85ab330163",
              "call_a0ea4888736a4adca223f06261da55c5"
            ]
          },
          {
            "text": "compile_model imports the same constant and writes it into config.json under quantization_config.version. Newly compiled outputs therefore receive 0.0.2 when that writing path completes; existing artifacts are not rewritten by this commit.",
            "basis": "source",
            "evidence": [
              "call_5c8b857fd19b4ee480b9c0bd1591b22e",
              "call_a0ea4888736a4adca223f06261da55c5"
            ]
          },
          {
            "text": "The manual build workflow reads version.py for its package-version output and derives the release tag and name from it. Upload remains conditional on release input '1' and successful version parsing; changing the constant does not itself launch publication.",
            "basis": "source",
            "evidence": [
              "call_36974921cc0b40538089c545de7b0215",
              "call_a0ea4888736a4adca223f06261da55c5"
            ]
          }
        ]
      }
