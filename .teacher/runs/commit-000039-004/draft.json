      {
        "id": "nemotron-linear-replacement",
        "origin": "authoring_observation",
        "status": "suspected",
        "classification": "external_compatibility",
        "description": "Architecture registration covers less than the inspected Nemotron family: the 51B checkpoint requests an explicitly unsupported attention variant.",
        "trigger": "Construct DeciLMModel from the pinned Llama-3_1-Nemotron-51B-Instruct configuration, reaching an active attention block with replace_with_linear=true.",
        "expected_behavior": "Full compatibility with that checkpoint would require implementing its replacement attention branch.",
        "actual_behavior": "DeciLMModel.__init__ asserts that replace_with_linear is false and rejects the configuration rather than constructing that branch.",
        "locations": [
