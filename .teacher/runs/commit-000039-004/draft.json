      {
        "id": "empty-block-conversion",
        "origin": "authoring_observation",
        "status": "suspected",
        "classification": "defect",
        "description": "Fully disabled DeciLM blocks have zero weights, but conversion still calculates their bits per weight.",
        "trigger": "Convert a configuration containing attention.no_op=true and ffn.no_op=true, as in both inspected Ultra variants, and reach the module's bitrate-reporting step.",
        "expected_behavior": "Treat the empty block as a pass-through and skip or specially represent its undefined bits-per-weight statistic.",
        "actual_behavior": "The constructor appends an empty TransformerBlock. Module.weights_numel returns zero; conversion skips allocation because there are no linears but subsequently evaluates num_bits / module.weights_numel(), giving a zero denominator.",
        "locations": [
          {
            "commit": "75c7366bb2e2a7671e38d079f9e5f54945b78006",
            "path": "exllamav3/models/decilm.py",
