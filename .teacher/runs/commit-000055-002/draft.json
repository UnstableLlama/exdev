    "type": "performance",
    "problem": [
      {
        "text": "Wide gated MLPs require large weights and quadratic-size down-projection Hessians during conversion. The patch introduces a default splitting threshold of 55,296 intermediate features.",
        "basis": "source",
        "evidence": [
          "call_30f73a550d8e48e8b778222b023d7998",
          "call_a9f64886943e4d3bbd310920725078a5"
        ]
      }
    ],
    "reasoning": [
      {
        "text": "Quantizing one intermediate-feature slice at a time reduces the active down-projection Hessian and weight sizes, at the cost of repeated loading, calibration and attention quantization. This is a memory-versus-work tradeoff, not a measured performance improvement.",
        "basis": "inference",
        "evidence": [
          "call_8c9232a36a1241888bd85f12369d8957",
          "call_8c9b6193c487430980b7816933859155",
          "call_a9f64886943e4d3bbd310920725078a5"
        ]
      }
    ],
    "impact": [
