    "problem": [
      {
        "text": "The registry did not recognize Gemma3. Its nested text configuration, checkpoint namespace and local/global attention pattern require a dedicated adapter.",
        "basis": "source",
        "evidence": [
          "call_69cca3607afc420c880ea66d9842c18b",
          "call_0ce81ed200e6422cb7f20de51383aebc",
          "call_27d2297897b64655a9b89f49e5eece61"
        ]
      }
    ],
    "reasoning": [
      {
        "text": "The change combines a Gemma2-like decoder with per-head Q/K normalization and separate local/global RoPE settings. Extending the shared RoPE reader is a prerequisite for reading nested global settings while deliberately isolating local attention from that scaling.",
        "basis": "source",
        "evidence": [
          "call_45b7e406dc58464faea408ee8c4d86cc",
          "call_de57fe284431446dba1b56f46eb2e3c5",
          "call_27d2297897b64655a9b89f49e5eece61"
        ]
      }
    ],
    "impact": [
      {
        "text": "Gemma3ForConditionalGeneration becomes selectable through the existing configuration factory, with text as the default component. Vision inference remains unimplemented, but compilation can preserve the vision tower and multimodal projector tensors.",
        "basis": "source",
        "evidence": [
          "call_0ce81ed200e6422cb7f20de51383aebc",
