    "limitations": [
      "The scalar check did not instantiate Generator or run repository generation, NumPy conversion, CUDA, or TabbyAPI.",
      "No static type checker was run; external callers of the UTF-32 helper were not inspected."
    ],
    "links": [
      "809b0dab40c5f576bd84e38b0712cc5c3011f21e"
    ],
    "chapters": [
      {
        "id": "generation",
        "title": "Restore capacity diagnostics and refine annotations",
        "claims": [
          {
            "text": "Generator.enqueue calls Job.prepare_for_queue before appending a job. Its capacity assertion formats max_total_tokens only on rejection; adding the attribute repairs this error-reporting path, not cache allocation or scheduling.",
            "basis": "source",
            "evidence": [
              "call_193c64dafd5e4b03babe85f0e2437fc1",
              "call_5e710b90bf8848e6895943abaa44b439",
              "call_5baa4c4da0eb4167924be38825711a88"
            ]
          },
          {
            "text": "PAGE_SIZE is 256 tokens. PageTable computes max_pages as cache.max_num_tokens // PAGE_SIZE, so the new product expresses whole-page capacity, not currently free tokens or a generation budget.",
            "basis": "source",
            "evidence": [
              "call_42675c1b0ba0443eba75592c823ba5de",
              "call_0e921a2ea6064e898636ba6419c7532c",
              "call_5baa4c4da0eb4167924be38825711a88"
            ]
          },
          {
            "text": "Scalar arithmetic yielded capacities of 256, 256, 256 and 512 for hypothetical cache sizes of 256, 257, 511 and 512 tokens, respectively, illustrating the page rounding.",
            "basis": "execution",
            "evidence": [
              "call_12f46200a6ce481ea766e99fb0bd163d"
            ]
          },
          {
            "text": "The seed annotation changes from int or None to int | None while preserving its None default. The UTF-32 helper now declares tuple[np.ndarray, np.ndarray] | None. Neither edit changes runtime assertions or return statements.",
            "basis": "source",
            "evidence": [
              "call_5baa4c4da0eb4167924be38825711a88",
              "call_96ef90c32a984439a3b53e5dcc2470aa"
            ]
          },
          {
            "text": "For nonempty input, _strings_to_utf32 concatenates UTF-32 little-endian bytes and constructs cumulative byte offsets, exposing both buffers as uint8 NumPy arrays. Job construction unpacks these for stop strings and banned strings, so the revised annotation better describes the nonempty result.",
            "basis": "source",
            "evidence": [
              "call_d58c1b3dee9f4f0db6fb8018912c84bd",
              "call_b04875b7957b4fd0b1b5cc8bfc28994e"
            ]
          },
          {
            "text": "The second-parent explanation already identified an empty-input annotation mismatch. Inspection of the merge diff and unchanged helper body shows that mismatch is carried over.",
            "basis": "source",
            "evidence": [
              "call_0394cce521384257b3bc343fba75ba19",
              "call_96ef90c32a984439a3b53e5dcc2470aa",
              "call_d58c1b3dee9f4f0db6fb8018912c84bd"
            ]
          }
        ]
      }
    ],
    "findings": [
      {
        "id": "empty-utf32-annotation",
        "origin": "authoring_observation",
        "status": "suspected",
        "classification": "defect",
        "description": "The revised helper annotation excludes its unchanged empty-input return value.",
        "trigger": "_strings_to_utf32([]), including Job construction with non-None stop_conditions containing no strings.",
        "expected_behavior": "The declared return type should include the empty-input pair, or the implementation should return a matching value.",
        "actual_behavior": "The helper returns (bytearray(), None), neither a pair of ndarrays nor standalone None. This is a typing mismatch, not an established runtime regression.",
        "locations": [
          {
