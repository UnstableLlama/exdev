  "annotation": {
    "schema_version": 5,
    "type": "bugfix",
    "problem": [
      {
        "text": "Oversized-job rejection referenced Generator.max_total_tokens without initializing it, allowing an AttributeError to mask the intended capacity assertion.",
        "basis": "source",
        "evidence": [
          "call_bff99b28b85444259d6b99f4ee6b4e9f",
          "call_5e710b90bf8848e6895943abaa44b439",
          "call_2c2c469fd6e9415cb0e4af3f8bf7b0b7"
        ]
      }
    ],
    "reasoning": [
      {
        "text": "Initializing the attribute from PageTable.max_pages supplies the existing diagnostic with usable whole-page capacity without changing its admission predicate.",
        "basis": "source",
        "evidence": [
          "call_5baa4c4da0eb4167924be38825711a88",
          "call_0e921a2ea6064e898636ba6419c7532c",
          "call_5e710b90bf8848e6895943abaa44b439"
        ]
      }
    ],
    "impact": [
      {
        "text": "A scalar reproduction of the failing assertion changed AttributeError into the intended AssertionError after supplying the attribute.",
        "basis": "execution",
        "evidence": [
          "call_12f46200a6ce481ea766e99fb0bd163d"
        ]
      }
    ],
    "source_notes": [
      {
        "text": "PR #36 author tokoba reported encountering the missing attribute in TabbyAPI, adding it, and successfully trying the build. This is the contributor's report, not an independent integration test. Turboderp subsequently indicated approval and planned merging into dev.",
        "basis": "source",
        "evidence": [
          "call_3776b6f2d95649ed9d4f70911263b61a",
          "call_f6bb56ca0be84329a77b8cc9d2b0e431"
        ]
      },
      {
        "text": "The reported traceback's max_total_tokens formatting expression matches the repository's oversized-job diagnostic, supporting a connection to that path rather than establishing a separate TabbyAPI-side defect.",
        "basis": "inference",
        "evidence": [
          "call_3776b6f2d95649ed9d4f70911263b61a",
          "call_5e710b90bf8848e6895943abaa44b439"
        ]
      },
      {
        "text": "Closed issue #33, \u201cError converting model,\u201d concerns file opening during conversion and ultimately reports \u201cToo many open files\u201d; it supplies no evidence of the generator-capacity failure.",
        "basis": "source",
        "evidence": [
