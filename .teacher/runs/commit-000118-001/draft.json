    "type": "bugfix",
    "problem": [
      {
        "text": "The optional cache visualizer imported tkinter unconditionally. Because both package initializers eagerly import Generator, unavailable tkinter could prevent ordinary exllamav3 imports, even with visualization disabled, provided earlier imports succeeded.",
        "basis": "source",
        "evidence": [
          "call_8a769f913b614151b37bebe24c935266",
          "call_3837bfe059624fa8a1d707eec4a7c2c4",
          "call_5d5246302c614fd095685f7f86b05a94",
          "call_176547de98194af1824dd0faccf4a749"
        ]
      }
    ],
    "reasoning": [
      {
        "text": "Moving the import into CacheVisualizer.__init__ aligns the GUI dependency with actual window construction rather than module loading.",
        "basis": "source",
        "evidence": [
          "call_779c6963c2b74f27aada3fcadfb7c12a"
        ]
      }
    ],
    "impact": [
      {
        "text": "Generator defaults show_visualizer to False and constructs CacheVisualizer only when enabled. That default path no longer attempts this tkinter import; enabling visualization still requires tkinter and successful Tk window creation.",
        "basis": "source",
        "evidence": [
          "call_3837bfe059624fa8a1d707eec4a7c2c4",
          "call_779c6963c2b74f27aada3fcadfb7c12a",
          "call_8a769f913b614151b37bebe24c935266"
        ]
      }
    ],
