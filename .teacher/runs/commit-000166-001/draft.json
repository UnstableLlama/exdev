    "type": "bugfix",
    "problem": [
      {
        "text": "Qwen3MoeConfig still supplied a bare model class, while Config stored it as model_classes and its consumers expected a component dictionary.",
        "basis": "source",
        "evidence": [
          "call_63b78b662a92465bae992a9684af6d96",
          "call_9bb71336784143b6812caa9e0327327f",
          "call_64b8f3a954b34fb6a8f8bc37c066d280",
          "call_79f1d99ee304425cbf688ee62bdf7d7d"
        ]
      }
    ],
    "reasoning": [
      {
        "text": "Wrapping Qwen3MoeModel in {\"text\": Qwen3MoeModel} satisfies both factory lookup and compilation's component enumeration without changing the model implementation.",
        "basis": "source",
        "evidence": [
          "call_39cd9b8a2dca4a6da47fa26e21f1dc3f",
          "call_64b8f3a954b34fb6a8f8bc37c066d280",
          "call_79f1d99ee304425cbf688ee62bdf7d7d"
        ]
      }
    ],
    "impact": [
      {
        "text": "The default text factory can now select Qwen3MoeModel. Compilation can enumerate its inherited additional-tensor hook, which returns an empty dictionary; this fix adds no auxiliary tensors or vision component.",
        "basis": "source",
        "evidence": [
          "call_39cd9b8a2dca4a6da47fa26e21f1dc3f",
          "call_64b8f3a954b34fb6a8f8bc37c066d280",
