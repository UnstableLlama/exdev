        ],
        "verification": [
          {
            "method": "source_inspection",
            "description": "Compared the unchanged helper with the new caller, position-grid construction, attention forwarding and native table-indexing guards.",
            "evidence": [
              "call_0035c45b902448e4b3b28252bf05770f",
              "call_3e30be17b6284c9b95e8ae7daa523b29",
              "call_2c6322bba0b744bb8f74173efb9b4a4d",
