{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exdev GPU test execution report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "defect_id", "ledger_revision", "ledger_file", "ledger_sha256", "attempt",
               "triage", "outcome", "summary", "what_ran", "limits", "tested", "modifications", "model",
               "environment", "files", "worker_model", "started_at", "finished_at"],
  "properties": {
    "schema_version": {"const": 1},
    "defect_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "ledger_revision": {"type": "string", "pattern": "^r[0-9]{3}$"},
    "ledger_file": {"type": "string"},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attempt": {"type": "string", "pattern": "^[0-9]{3}$"},
    "triage": {"enum": ["cpu", "gpu", "needs_model", "packaging_ci", "not_testable_here"]},
    "outcome": {"enum": ["reproduced", "fix_confirmed", "not_reproduced", "inconclusive", "blocked", "not_testable_here"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1200},
    "what_ran": {"type": "string", "minLength": 1},
    "limits": {"type": "string", "minLength": 1},
    "tested": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sha", "role", "behaviour", "exception_type", "exception_site", "returncode", "stdout", "stderr"],
        "properties": {
          "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "role": {"enum": ["affected", "fix_parent", "fix", "introduction", "introduction_parent"]},
          "behaviour": {"enum": ["stated_behaviour", "expected_behaviour", "other", "did_not_run"]},
          "exception_type": {"type": ["string", "null"]},
          "exception_site": {"type": ["string", "null"], "description": "path:line in the repository, or null"},
          "returncode": {"type": ["integer", "null"]},
          "stdout": {"type": "string"}, "stderr": {"type": "string"}
        }
      }
    },
    "modifications": {"type": "array", "items": {"type": "string"},
                      "description": "Every stub, monkeypatch or source change used. Empty means the unmodified code path."},
    "model": {"type": ["object", "null"], "additionalProperties": false,
              "required": ["repo_id", "revision", "quantized_with_sha"],
              "properties": {"repo_id": {"type": "string"}, "revision": {"type": "string"},
                             "quantized_with_sha": {"type": ["string", "null"]}}},
    "environment": {"type": "string", "description": "file name of env.json in this directory"},
    "files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "worker_model": {"type": "string"},
    "started_at": {"type": "string"}, "finished_at": {"type": "string"}
  }
}
